{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssetBundle",
  "type": "object",
  "required": ["bundle_id", "workspace_id", "source", "assets", "dependencies", "license"],
  "properties": {
    "bundle_id": { "type": "string" },
    "workspace_id": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["agent_generated", "human_uploaded", "synced", "external", "manual"] },
        "task_run_id": { "type": "string" },
        "work_item_id": { "type": "string" },
        "outline_doc_id": { "type": "string" },
        "generator": { "type": "string" },
        "uri": { "type": "string" },
        "ref": { "type": "string" }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "kind", "target_path"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "kind": {
            "type": "string",
            "enum": ["mesh", "texture", "material", "audio", "scene", "animation", "script", "import_meta", "other"]
          },
          "target_path": { "type": "string" },
          "import_preset": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "license": {
      "type": "object",
      "required": ["type", "attribution_required"],
      "properties": {
        "type": { "type": "string" },
        "attribution_required": { "type": "boolean" },
        "attribution_text": { "type": "string" },
        "spdx_id": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
