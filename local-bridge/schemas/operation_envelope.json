{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OperationEnvelope",
  "type": "object",
  "required": ["envelope_id", "work_item_id", "task_run_id", "operations", "risk_level", "requires_approval", "created_at"],
  "properties": {
    "envelope_id": { "type": "string" },
    "work_item_id": { "type": "string" },
    "task_run_id": { "type": "string" },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "path": { "type": "string" },
          "patch": { "type": "string" },
          "scene": { "type": "string" },
          "actions": {
            "type": "array",
            "items": { "type": "object" }
          },
          "property": { "type": "string" },
          "value": {},
          "description": { "type": "string" },
          "validation_plan": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "requires_approval": { "type": "boolean" },
    "approval_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "requires_approval": { "const": true }
        },
        "required": ["requires_approval"]
      },
      "then": {
        "required": ["approval_id"]
      }
    }
  ],
  "additionalProperties": false
}
